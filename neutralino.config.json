{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.weekbox.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "http://localhost:5173",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "exportAuthInfo": true,
  "nativeAllowList": [
    "app.*",
    "clipboard.*",
    "computer.*",
    "custom.*",
    "debug.*",
    "events.*",
    "extensions.*",
    "filesystem.*",
    "net.*",
    "os.*",
    "resources.*",
    "storage.*",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "WeekBox",
      "width": 1000,
      "height": 700,
      "minWidth": 600,
      "minHeight": 400,
      "hidden": false,
      "enableInspector": true,
      "resizable": true,
      "injectGlobals": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "WeekBox",
    "resourcesPath": "/dist/",
    "clientLibrary": "/public/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}