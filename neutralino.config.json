{
  "applicationId": "com.weekbox.app",
  "storageLocation": "system",
  "applicationIcon": "app/assets/icons/launcher-icon.png",
  "version": "3.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/app/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "exportAuthInfo": true,
  "singleInstance": true,
  "nativeAllowList": [
    "app.*",
    "computer.*",
    "debug.*",
    "os.*",
    "window.*",
    "events.*",
    "filesystem.*",
    "extensions.*",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "WeekBox",
      "icon": "/app/assets/icons/launcher-icon.png",
      "width": 1280,
      "height": 720,
      "minWidth": 800,
      "minHeight": 500,
      "hidden": true,
      "enableInspector": false,
      "openInspectorOnStartup": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "webviewArgs": "--autoplay-policy=no-user-gesture-required --disable-features=PreloadMediaEngagementData,MediaEngagementBypassAutoplayPolicies"
    }
  },
  "extensions": [
    {
      "id": "extNode",
      "commandDarwin": "sh -c 'export PATH=\"/opt/homebrew/bin:/usr/local/bin:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -n 1)/bin:$PATH\"; exec node \"${NL_PATH}/extensions/backend/node/main.js\" \"$@\"' dummy",
      "commandLinux": "node ${NL_PATH}/extensions/backend/node/main.js",
      "commandWindows": "node ${NL_PATH}/extensions/backend/node/main.js"
    }
  ],
  "cli": {
    "binaryName": "WeekBox",
    "resourcesPath": "/app/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/app/src/backend/core/native/pc/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}