{
  "name": "weekbox",
  "version": "2.1.10",
  "description": "A Re-Imagined Original FNF Mod Launcher",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write \"app/**/*.{js,css,html,json}\"",
    "locales:check": "node scripts/check-locales.js",
    "locales:check:strict": "node scripts/check-locales.js --strict",
    "locales:sync": "node scripts/sync-locales.js",
    "assets": "node scripts/bundle.js",
    "package:macos": "node scripts/package-macos.js",
    "package:linux": "node scripts/package-linux.js",
    "postinstall": "npx @neutralinojs/neu update",
    "dev": "npm run assets && npm-run-all --parallel \"assets -- --watch\" neu",
    "neu": "npx @neutralinojs/neu run",
    "build": "npm run assets && npx @neutralinojs/neu build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crew-Awesome/Weekbox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Crew-Awesome/Weekbox/issues"
  },
  "homepage": "https://github.com/Crew-Awesome/Weekbox#readme",
  "devDependencies": {
    "@neutralinojs/neu": "11.7.2",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "marked": "^18.0.7"
  }
}
